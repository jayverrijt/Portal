@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Dashboard - Portal</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0 text-nord-snow">⚡ Portal Dashboard</h2>
        <p class="text-nord-dim m-0">Centraal beheeroverzicht</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card p-4 border-nord bg-nord-dark h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-nord-snow mb-2">📁 Projecten</h5>
                <p class="text-nord-dim small">School- en freelance-projecten, deadlines en documentatie.</p>
            </div>
            <a href="projects" class="btn btn-primary btn-sm mt-3">Naar Projecten</a>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card p-4 border-nord bg-nord-dark h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-nord-snow mb-2">⚡ FlowBoards</h5>
                <p class="text-nord-dim small">Kanban workflow, sprints en taakkaarten.</p>
            </div>
            <a href="flowboard" class="btn btn-outline-secondary btn-sm mt-3">Naar FlowBoards</a>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card p-4 border-nord bg-nord-dark h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-nord-snow mb-2">📝 Notities</h5>
                <p class="text-nord-dim small">Markdown documentatie en snippets.</p>
            </div>
            <a href="notes" class="btn btn-outline-secondary btn-sm mt-3">Naar Notities</a>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card p-4 border-nord bg-nord-dark h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-nord-snow mb-2">🛠️ Utils Hub</h5>
                <p class="text-nord-dim small">Shortener, Weight Tracker & Pastebin.</p>
            </div>
            <a href="utils" class="btn btn-primary btn-sm mt-3">Open Utils</a>
        </div>
    </div>
</div>