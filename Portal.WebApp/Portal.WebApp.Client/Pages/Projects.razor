@page "/projects"
@attribute [Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Portal.DTOs.Projects
@using Portal.DTOs.Notes
@using Portal.DTOs.Reminders
@using Portal.WebApp.Client.Components
@inject HttpClient Http

<PageTitle>Projecten & FlowBoards</PageTitle>

@if (_activeProjectForBoard != null)
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <button class="btn btn-outline-secondary btn-sm mb-2" @onclick="() => _activeProjectForBoard = null">
                <i class="fa-solid fa-arrow-left me-1"></i> Terug naar Projecten
            </button>
            <h2 class="fw-bold m-0 text-nord-snow">⚡ FlowBoard: @_activeProjectForBoard.Title</h2>
            <p class="text-nord-dim m-0">Project-specifieke sprints, labels en kanban workflow</p>
        </div>
    </div>

    <FlowBoardView ProjectId="_activeProjectForBoard.Id" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0 text-nord-snow">📁 Projecten & Vakken</h2>
            <p class="text-nord-dim m-0">Centraal overzicht van projecten, FlowBoards en documentatie</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="OpenNewProjectModal">
            <i class="fa-solid fa-plus me-1"></i> Nieuw Project
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span>@_errorMessage</span>
            <button type="button" class="btn-close" @onclick="ClearErrorMessage"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-nord-dim">Projecten ophalen...</p>
        </div>
    }
    else if (_projects == null || !_projects.Any())
    {
        <div class="card card-body text-center py-5 bg-nord-dark border-nord">
            <h5 class="text-nord-snow">Nog geen projecten aanwezig</h5>
            <p class="text-nord-dim small">Maak een project of schoolvak aan om te beginnen.</p>
            <div>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenNewProjectModal">
                    <i class="fa-solid fa-plus me-1"></i> Project Toevoegen
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var project in _projects)
            {
                <div class="col-lg-6">
                    <div class="card h-100 shadow-sm border-nord bg-nord-card">
                        <div class="card-header bg-nord-dark border-nord d-flex justify-content-between align-items-center py-3">
                            <h5 class="card-title fw-bold m-0 text-nord-ice">@project.Title</h5>
                            <button class="btn btn-sm btn-primary" @onclick="() => _activeProjectForBoard = project">
                                ⚡ Open FlowBoard
                            </button>
                        </div>

                        <div class="card-body d-flex flex-column gap-3">
                            @if (!string.IsNullOrWhiteSpace(project.Description))
                            {
                                <p class="card-text text-nord-snow mb-0">@project.Description</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(project.RepositoryUrl))
                            {
                                <div>
                                    <a href="@project.RepositoryUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-brands fa-github me-1"></i> Repository Bekijken
                                    </a>
                                </div>
                            }

                            <div class="p-3 bg-nord-dark rounded border border-nord">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-uppercase text-nord-dim small m-0">Aantekeningen (@project.Notes.Count)</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-2" @onclick="() => OpenProjectNotes(project)">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Notities Openen
                                    </button>
                                </div>
                                @if (project.Notes.Any())
                                {
                                    <div class="d-flex flex-column gap-1 small">
                                        @foreach (var note in project.Notes.Take(2))
                                        {
                                            <div class="text-truncate text-nord-snow py-1 border-bottom border-nord border-opacity-25">
                                                <strong class="text-nord-ice">• @note.Title:</strong> <span class="text-nord-dim">@note.Content</span>
                                            </div>
                                        }
                                        @if (project.Notes.Count > 2)
                                        {
                                            <div class="text-nord-dim fst-italic pt-1" style="font-size: 0.75rem;">
                                                + @(project.Notes.Count - 2) overige aantekeningen...
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-nord-dim small m-0 fst-italic">Geen notities aanwezig.</p>
                                }
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-uppercase text-nord-dim small m-0">Actiepunten (@project.Reminders.Count)</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-nord-ice" @onclick="() => OpenAddReminderModal(project.Id)">
                                        <i class="fa-solid fa-plus me-1"></i> Taak
                                    </button>
                                </div>
                                @if (project.Reminders.Any())
                                {
                                    <div class="list-group list-group-flush rounded border border-nord">
                                        @foreach (var reminder in project.Reminders)
                                        {
                                            <div class="list-group-item bg-nord-dark border-nord d-flex justify-content-between align-items-center text-nord-snow py-2 px-3">
                                                <div>
                                                    <span class="@(reminder.IsCompleted ? "text-decoration-line-through text-nord-dim" : "fw-semibold text-nord-snow")">
                                                        @reminder.Title
                                                    </span>
                                                    @if (reminder.DueDate != default)
                                                    {
                                                        <div class="text-nord-dim" style="font-size: 0.75rem;">
                                                            Deadline: @reminder.DueDate.ToLocalTime().ToString("dd MMM HH:mm")
                                                        </div>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-sm @(reminder.IsCompleted ? "btn-nord-success" : "btn-outline-secondary")"
                                                        style="font-size: 0.75rem; padding: 3px 10px;"
                                                        @onclick="() => ToggleReminder(reminder)">
                                                    <span>@(reminder.IsCompleted ? "Voltooid" : "Aanvinken")</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-nord-dim small fst-italic mb-0">Geen actieve herinneringen.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@if (_showNewProjectModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Nieuw Project Aanmaken</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Titel</label>
                        <input type="text" class="form-control" placeholder="bijv. Semester 3 Project" @bind="_newProject.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beschrijving</label>
                        <textarea class="form-control" rows="3" placeholder="Korte toelichting..." @bind="_newProject.Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Repository URL (Optioneel)</label>
                        <input type="text" class="form-control" placeholder="https://github.com/..." @bind="_newProject.RepositoryUrl" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModals">Annuleren</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateProject">Opslaan</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_selectedProjectIdForReminder != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Actiepunt / Deadline Toevoegen</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Titel</label>
                        <input type="text" class="form-control" placeholder="bijv. Documentatie inleveren" @bind="_newReminder.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beschrijving</label>
                        <input type="text" class="form-control" @bind="_newReminder.Description" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Deadline</label>
                        <input type="datetime-local" class="form-control" @bind="_newReminderDueDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModals">Annuleren</button>
                    <button type="button" class="btn btn-primary" @onclick="CreateReminder">Toevoegen</button>
                </div>
            </div>
        </div>
    </div>
}

<ProjectNotesView IsOpen="_showNotesModal"
                  Project="_activeProjectForNotes"
                  Notes="_activeProjectForNotes?.Notes ?? new()"
                  OnClosed="() => _showNotesModal = false"
                  OnNotesUpdated="HandleNotesUpdated" />

@code {
    private List<ProjectDto>? _projects;
    private bool _isLoading = true;
    private string? _errorMessage;

    private bool _showNewProjectModal;
    private Guid? _selectedProjectIdForReminder;
    private CreateProjectDto _newProject = new();
    private CreateReminderDto _newReminder = new();
    private DateTime _newReminderDueDate = DateTime.Now.AddDays(1);

    private bool _showNotesModal;
    private ProjectDto? _activeProjectForNotes;
    private ProjectDto? _activeProjectForBoard;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _projects = await Http.GetFromJsonAsync<List<ProjectDto>>("api/project");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij laden van projecten: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenProjectNotes(ProjectDto project)
    {
        _activeProjectForNotes = project;
        _showNotesModal = true;
    }

    private async Task HandleNotesUpdated()
    {
        await LoadProjects();
        if (_activeProjectForNotes != null)
        {
            _activeProjectForNotes = _projects?.FirstOrDefault(p => p.Id == _activeProjectForNotes.Id);
        }
    }

    private void OpenNewProjectModal() => _showNewProjectModal = true;
    private void ClearErrorMessage() => _errorMessage = null;
    private void CloseModals()
    {
        _showNewProjectModal = false;
        _selectedProjectIdForReminder = null;
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(_newProject.Title))
        {
            _errorMessage = "Voer een titel in voor het project.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/project", _newProject);
            if (response.IsSuccessStatusCode)
            {
                CloseModals();
                _newProject = new CreateProjectDto();
                await LoadProjects();
            }
            else
            {
                _errorMessage = "Project kon niet worden aangemaakt.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij aanmaken project: {ex.Message}";
        }
    }

    private void OpenAddReminderModal(Guid projectId)
    {
        _selectedProjectIdForReminder = projectId;
        _newReminder = new CreateReminderDto { ProjectId = projectId };
        _newReminderDueDate = DateTime.Now.AddDays(1);
    }

    private async Task CreateReminder()
    {
        if (_selectedProjectIdForReminder == null) return;

        if (string.IsNullOrWhiteSpace(_newReminder.Title))
        {
            _errorMessage = "Voer een titel in voor het actiepunt.";
            return;
        }

        _newReminder.DueDate = _newReminderDueDate;

        try
        {
            var response = await Http.PostAsJsonAsync("api/reminders", _newReminder);
            if (response.IsSuccessStatusCode)
            {
                CloseModals();
                await LoadProjects();
            }
            else
            {
                _errorMessage = "Actiepunt kon niet worden opgeslagen.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij toevoegen herinnering: {ex.Message}";
        }
    }

    private async Task ToggleReminder(ReminderDto reminder)
    {
        try
        {
            var response = await Http.PatchAsync($"api/reminders/{reminder.Id}/toggle", null);
            if (response.IsSuccessStatusCode)
            {
                reminder.IsCompleted = !reminder.IsCompleted;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij bijwerken status: {ex.Message}";
        }
    }
}