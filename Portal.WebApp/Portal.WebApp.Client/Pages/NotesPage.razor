@page "/notes"
@attribute [Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Portal.DTOs.Notes
@using Portal.DTOs.Projects
@using Portal.WebApp.Client.Components
@inject HttpClient Http

<PageTitle>Notities - Portal</PageTitle>

<div class="portal-content-scroll p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0 text-nord-snow">Notities & Documentatie</h2>
            <p class="text-nord-dim m-0">Beheer persoonlijke aantekeningen en gekoppelde projectnotities</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="fa-solid fa-plus me-1"></i> Nieuwe Notitie
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-2 px-3 small mb-4 border-0 text-nord-snow d-flex justify-content-between align-items-center rounded-3 shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-triangle-exclamation me-2 fs-6 text-nord-yellow"></i>
                <span>@_errorMessage</span>
            </div>
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-nord-ice" role="status"></div>
            <p class="mt-2 text-nord-dim">Notities ophalen...</p>
        </div>
    }
    else if (!_notes.Any())
    {
        <div class="card card-body text-center py-5 bg-nord-dark border-nord shadow-sm">
            <div class="d-inline-flex align-items-center justify-content-center bg-nord-surface rounded-circle mx-auto mb-3" style="width: 54px; height: 54px;">
                <i class="fa-solid fa-note-sticky text-nord-ice fs-4"></i>
            </div>
            <h5 class="text-nord-snow fw-bold">Geen notities gevonden</h5>
            <p class="text-nord-dim small mb-3">Je hebt nog geen persoonlijke notities aangemaakt of gedeeld gekregen.</p>
            <div>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenCreateModal">
                    <i class="fa-solid fa-plus me-1"></i> Eerste Notitie Aanmaken
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var note in _notes.OrderByDescending(n => n.CreatedAt))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="card h-100 shadow-sm border-nord bg-nord-dark d-flex flex-column">
                        <div class="card-header bg-nord-card border-nord d-flex justify-content-between align-items-center py-2 px-3">
                            <h6 class="fw-bold m-0 text-nord-ice text-truncate" title="@note.Title">@note.Title</h6>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm p-1 text-nord-dim hover-ice" title="Bewerken" @onclick="() => EditNote(note)">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button type="button" class="btn btn-sm p-1 text-nord-red" title="Verwijderen" @onclick="() => DeleteNote(note.Id)">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body p-3 flex-grow-1 overflow-y-auto" style="max-height: 250px;">
                            <MarkdownView Content="@note.Content" />
                        </div>
                        <div class="card-footer bg-nord-card border-nord py-2 px-3 d-flex justify-content-between align-items-center">
                            <small class="text-nord-dim" style="font-size: 0.75rem;">
                                @note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </small>
                            @if (note.ProjectId.HasValue)
                            {
                                <span class="badge border border-nord bg-nord-surface text-nord-ice" style="font-size: 0.7rem;">
                                    <i class="fa-solid fa-folder me-1"></i> Gekoppeld Project
                                </span>
                            }
                            else
                            {
                                <span class="badge border border-nord bg-nord-surface text-nord-dim" style="font-size: 0.7rem;">
                                    Persoonlijk
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); backdrop-filter: blur(2px); z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-nord-snow">@(_editingNoteId.HasValue ? "Notitie Bewerken" : "Nieuwe Notitie")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3 border-0 text-nord-snow" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> @_modalErrorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label text-nord-snow small fw-semibold">Titel</label>
                        <input type="text" class="form-control" placeholder="bijv. Docker CheatSheet of Architectuur Keuzes" @bind="_modalTitle" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-nord-snow small fw-semibold">Koppelen aan Project (Optioneel)</label>
                        <select class="form-select" @bind="_modalProjectId">
                            <option value="">-- Geen project (Persoonlijke Notitie) --</option>
                            @foreach (var proj in _projects)
                            {
                                <option value="@proj.Id">@proj.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-nord-snow small fw-semibold">Inhoud (Markdown)</label>
                        <RichNoteEditor @bind-Value="_modalContent" />
                    </div>
                </div>
                <div class="modal-footer border-nord">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuleren</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNote" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Opslaan...</span>
                        }
                        else
                        {
                            <span>Opslaan</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<NoteDto> _notes = new();
    private List<ProjectDto> _projects = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _modalErrorMessage;

    private bool _showModal;
    private Guid? _editingNoteId;
    private string _modalTitle = string.Empty;
    private string _modalContent = string.Empty;
    private string _modalProjectId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var notesTask = Http.GetFromJsonAsync<List<NoteDto>>("api/notes");
            var projectsTask = Http.GetFromJsonAsync<List<ProjectDto>>("api/project");

            await Task.WhenAll(notesTask, projectsTask);

            _notes = await notesTask ?? new();
            _projects = await projectsTask ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij laden van gegevens: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _editingNoteId = null;
        _modalTitle = string.Empty;
        _modalContent = string.Empty;
        _modalProjectId = string.Empty;
        _modalErrorMessage = null;
        _showModal = true;
    }

    private void EditNote(NoteDto note)
    {
        _editingNoteId = note.Id;
        _modalTitle = note.Title;
        _modalContent = note.Content;
        _modalProjectId = note.ProjectId?.ToString() ?? string.Empty;
        _modalErrorMessage = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _modalErrorMessage = null;
    }

    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(_modalTitle))
        {
            _modalErrorMessage = "Titel is verplicht.";
            return;
        }

        _isSaving = true;
        _modalErrorMessage = null;

        Guid? projId = Guid.TryParse(_modalProjectId, out var parsedGuid) ? parsedGuid : null;

        try
        {
            HttpResponseMessage response;
            if (_editingNoteId.HasValue)
            {
                var updateDto = new UpdateNoteDto
                {
                    Title = _modalTitle,
                    Content = _modalContent,
                    ProjectId = projId
                };
                response = await Http.PutAsJsonAsync($"api/notes/{_editingNoteId.Value}", updateDto);
            }
            else
            {
                var createDto = new CreateNoteDto
                {
                    Title = _modalTitle,
                    Content = _modalContent,
                    ProjectId = projId
                };
                response = await Http.PostAsJsonAsync("api/notes", createDto);
            }

            if (response.IsSuccessStatusCode)
            {
                CloseModal();
                await LoadData();
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                _modalErrorMessage = errorObj?.Message ?? $"Fout ({response.StatusCode}): Actie kon niet worden voltooid.";
            }
        }
        catch (Exception ex)
        {
            _modalErrorMessage = $"Verbindingsfout: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteNote(Guid noteId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/notes/{noteId}");
            if (response.IsSuccessStatusCode)
            {
                _notes.RemoveAll(n => n.Id == noteId);
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
                _errorMessage = errorObj?.Message ?? "Kon notitie niet verwijderen. Mogelijk ontbreken de benodigde rechten.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij verwijderen: {ex.Message}";
        }
    }

    private class ApiErrorResponse
    {
        public string? Message { get; set; }
    }
}