@page "/register"
@rendermode InteractiveAuto
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="flex min-h-[70vh] items-center justify-center px-4">
    <div class="w-full max-w-md rounded-2xl bg-slate-900/80 p-8 shadow-xl border border-slate-800 backdrop-blur-sm text-slate-100">
        <h2 class="text-2xl font-bold tracking-tight text-white mb-2">Account aanmaken</h2>
        <p class="text-sm text-slate-400 mb-6">Vul je gegevens in om toegang te krijgen tot Portal.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-4 rounded-lg bg-red-500/10 border border-red-500/30 p-3 text-sm text-red-400">
                @errorMessage
            </div>
        }

        <EditForm Model="@model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Gebruikersnaam</label>
                <InputText @bind-Value="model.Username" class="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-white placeholder-slate-500 focus:border-blue-500 focus:outline-none" placeholder="bijv. jayv" />
            </div>

            <div class="mb-4">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">E-mailadres</label>
                <InputText @bind-Value="model.Email" type="email" class="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-white placeholder-slate-500 focus:border-blue-500 focus:outline-none" placeholder="naam@voorbeeld.nl" />
            </div>

            <div class="mb-6">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Wachtwoord</label>
                <InputText @bind-Value="model.Password" type="password" class="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-white placeholder-slate-500 focus:border-blue-500 focus:outline-none" placeholder="••••••••" />
            </div>

            <button type="submit" disabled="@isLoading" class="w-full rounded-lg bg-blue-600 px-4 py-2.5 font-semibold text-white transition hover:bg-blue-500 focus:outline-none disabled:opacity-50">
                @(isLoading ? "Bezig met aanmaken..." : "Registreren")
            </button>
        </EditForm>

        <p class="mt-6 text-center text-xs text-slate-400">
            Heb je al een account? 
            <a href="/login" class="text-blue-400 hover:underline font-medium">Inloggen</a>
        </p>
    </div>
</div>

@code {
    private RegisterFormModel model = new();
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = errorResult?.Message ?? "Registratie mislukt. Zorg dat je wachtwoord sterk genoeg is (hoofdletter, cijfer, speciaal teken).";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Er ging iets mis: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class RegisterFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string? Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class ErrorResponse
    {
        public string? Message { get; set; }
    }
}