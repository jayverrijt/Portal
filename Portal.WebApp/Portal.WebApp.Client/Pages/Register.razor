@page "/register"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Portal.DTOs.Auth
@using Portal.WebApp.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registreren - Portal</PageTitle>

<div class="card border-nord shadow-lg bg-nord-dark p-4 rounded-3">
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-nord-surface rounded-circle mb-2" style="width: 54px; height: 54px;">
            <i class="fa-solid fa-user-plus text-nord-yellow fs-3"></i>
        </div>
        <h3 class="fw-bold text-nord-snow m-0">Portal</h3>
        <p class="text-nord-dim small m-0">Maak een nieuw account aan</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-2 small mb-3 border-0 text-nord-snow" style="background-color: var(--nord11);" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> @_errorMessage
        </div>
    }

    <EditForm Model="_registerModel" OnValidSubmit="HandleRegister">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label text-nord-snow small fw-semibold">Gebruikersnaam</label>
            <div class="input-group">
                <span class="input-group-text bg-nord-surface border-nord text-nord-dim">
                    <i class="fa-solid fa-user"></i>
                </span>
                <InputText class="form-control" placeholder="Gebruikersnaam" @bind-Value="_registerModel.UserName" />
            </div>
            <ValidationMessage For="() => _registerModel.UserName" class="text-danger small mt-1" />
        </div>

        <div class="mb-3">
            <label class="form-label text-nord-snow small fw-semibold">E-mailadres</label>
            <div class="input-group">
                <span class="input-group-text bg-nord-surface border-nord text-nord-dim">
                    <i class="fa-solid fa-envelope"></i>
                </span>
                <InputText type="email" class="form-control" placeholder="naam@voorbeeld.nl" @bind-Value="_registerModel.Email" />
            </div>
            <ValidationMessage For="() => _registerModel.Email" class="text-danger small mt-1" />
        </div>

        <div class="mb-4">
            <label class="form-label text-nord-snow small fw-semibold">Wachtwoord</label>
            <div class="input-group">
                <span class="input-group-text bg-nord-surface border-nord text-nord-dim">
                    <i class="fa-solid fa-lock"></i>
                </span>
                <InputText type="password" class="form-control" placeholder="••••••••" @bind-Value="_registerModel.Password" />
            </div>
            <ValidationMessage For="() => _registerModel.Password" class="text-danger small mt-1" />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3" disabled="@_isLoading">
            @if (_isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Account aanmaken...</span>
            }
            else
            {
                <span>Registreren</span>
            }
        </button>

        <div class="text-center">
            <span class="text-nord-dim small">Heb je al een account? </span>
            <a href="/login" class="text-nord-yellow small fw-semibold text-decoration-none">Inloggen</a>
        </div>
    </EditForm>
</div>

@code {
    private RegisterFormModel _registerModel = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", _registerModel);

            if (response.IsSuccessStatusCode)
            {
                var authResult = await response.Content.ReadFromJsonAsync<AuthResponseDto>();

                if (authResult != null && !string.IsNullOrEmpty(authResult.Token))
                {
                    if (AuthStateProvider is CustomAuthStateProvider customAuth)
                    {
                        await customAuth.SetTokenAsync(authResult.Token);
                    }

                    Navigation.NavigateTo("/", forceLoad: false);
                }
                else
                {
                    // Fallback als token leeg is: doorsturen naar login
                    Navigation.NavigateTo("/login", forceLoad: false);
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(errorText) ? "Registratie mislukt. Controleer je gegevens." : errorText;
                _isLoading = false;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Verbindingsfout met API: {ex.Message}";
            _isLoading = false;
        }
    }

    public class RegisterFormModel
    {
        [Required(ErrorMessage = "Gebruikersnaam is verplicht.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-mailadres is verplicht.")]
        [EmailAddress(ErrorMessage = "Ongeldig e-mailadres.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Wachtwoord is verplicht.")]
        [MinLength(6, ErrorMessage = "Wachtwoord moet minimaal 6 tekens lang zijn.")]
        public string Password { get; set; } = string.Empty;
    }
}