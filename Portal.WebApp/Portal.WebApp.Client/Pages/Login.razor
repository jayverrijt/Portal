@page "/login"
@using System.Net.Http.Json
@using Portal.DTOs.Auth
@using Portal.WebApp.Client.Services
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Inloggen - Portal</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4 fw-bold">Portal Login</h3>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">E-mailadres</label>
                        <InputText @bind-Value="_loginModel.Email" class="form-control" placeholder="naam@voorbeeld.nl" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Wachtwoord</label>
                        <InputText @bind-Value="_loginModel.Password" type="password" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Inloggen
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginDto _loginModel = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task HandleLogin()
    {
        _isSubmitting = true;
        _errorMessage = null;
        var loginSuccessful = false;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", _loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponseDto>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    if (AuthStateProvider is CustomAuthStateProvider customStateProvider)
                    {
                        await customStateProvider.MarkUserAsAuthenticated(result.Token);
                    }
                    loginSuccessful = true;
                }
            }
            else
            {
                _errorMessage = "Ongeldige inloggegevens. Controleer je e-mail en wachtwoord.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij inloggen: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }

        if (loginSuccessful)
        {
            Navigation.NavigateTo("/projects");
        }
    }
}