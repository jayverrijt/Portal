@namespace Portal.WebApp.Client.Layout
@inherits LayoutComponentBase
@using Portal.WebApp.Client.Layout
@using Portal.WebApp.Client.Components

<div class="app-layout d-flex vh-100 overflow-hidden bg-nord-dark">
    <!-- NORD SIDEBAR -->
    <aside class="sidebar-container bg-nord-sidebar text-white flex-shrink-0 @(_isSidebarCollapsed ? "width-collapsed" : "width-expanded")">
        <NavMenu IsCollapsed="_isSidebarCollapsed" OnToggleSidebar="(val) => _isSidebarCollapsed = val" />
    </aside>

    <!-- MAIN CONTENT VIEWPORT -->
    <main class="main-content-viewport flex-grow-1 d-flex flex-column h-100 overflow-hidden bg-nord-main">
        <div class="content-body flex-grow-1 overflow-y-auto p-4 text-nord-snow">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _isSidebarCollapsed = false;
}