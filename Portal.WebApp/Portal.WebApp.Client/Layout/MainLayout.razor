@namespace Portal.WebApp.Client.Layout
@inherits LayoutComponentBase

<div class="d-flex w-100 h-100" style="height: 100vh; max-height: 100vh; overflow: hidden;">
    <!-- SIDEBAR -->
    <aside class="@(IsSidebarCollapsed ? "sidebar-collapsed" : "sidebar-expanded") flex-shrink-0 h-100" style="height: 100vh; overflow-y: auto;">
        <NavMenu IsCollapsed="@IsSidebarCollapsed" OnToggleSidebar="HandleSidebarToggle" />
    </aside>

    <!-- MAIN SCROLLABLE CONTENT -->
    <main class="flex-grow-1 h-100 portal-content-scroll" style="min-width: 0;">
        <div class="container-fluid p-4" style="padding-bottom: 120px !important;">
            @Body
        </div>
    </main>
</div>

@code {
    private bool IsSidebarCollapsed = false;

    private void HandleSidebarToggle(bool collapsed)
    {
        IsSidebarCollapsed = collapsed;
    }
}