@using System.Net.Http.Json
@using Portal.Domain.Enums
@using Portal.DTOs.Kanban
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="flowboard-container">
    <!-- TOP CONTROLS & FILTERS -->
    <div class="card p-3 shadow-sm border-0 mb-3 bg-nord-dark">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-nord-snow">Sprint Filter:</span>
                <select class="form-select form-select-sm w-auto" @bind="_selectedSprintFilter" @bind:after="ApplyFilter">
                    <option value="-1">Alle Sprints</option>
                    <option value="0">Geen Sprint</option>
                    @for (int i = 1; i <= 10; i++)
                    {
                        var sprintNr = i;
                        <option value="@sprintNr">Sprint @sprintNr</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                @if (_activeBoardId != Guid.Empty)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenShareModal">
                        <i class="fa-solid fa-share-nodes me-1"></i> Delen & Link
                    </button>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _showLabelModal = true">
                    <i class="fa-solid fa-tags me-1"></i> Labels Beheren
                </button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenCreateCardModal()">
                    <i class="fa-solid fa-plus me-1"></i> Nieuwe Use Case
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span>@_errorMessage</span>
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    <!-- KANBAN CANVAS -->
    <div class="flowboard-canvas">
        @foreach (var col in _columns)
        {
            var columnCards = _filteredCards.Where(c => c.Status == col.Status).ToList();

            <div class="flowboard-column shadow-sm">
                <!-- KOLOM HEADER -->
                <div class="d-flex justify-content-between align-items-center p-3 border-bottom border-nord bg-nord-dark rounded-top">
                    <span class="fw-bold small text-uppercase" style="color: @col.HeaderColor;">@col.Title</span>
                    <span class="badge bg-secondary rounded-pill">@columnCards.Count</span>
                </div>

                <!-- KAARTEN LIJST -->
                <div class="flowboard-card-list flex-grow-1"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(col.Status)">

                    @foreach (var itemCard in columnCards)
                    {
                        var currentCard = itemCard;
                        var doneSubTasks = currentCard.SubTasks.Count(st => st.Status == SubTaskStatus.Done);
                        var totalSubTasks = currentCard.SubTasks.Count;

                        <div class="flowboard-card card p-3 shadow-sm cursor-pointer position-relative user-select-none"
                             draggable="true"
                             @ondragstart="() => _draggedCard = currentCard"
                             @onclick="() => OpenEditCardModal(currentCard)">

                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
                                <h6 class="fw-bold m-0 text-nord-snow text-truncate flex-grow-1" title="@currentCard.Title">@currentCard.Title</h6>
                                <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                    @if (currentCard.MoscowPriority.HasValue)
                                    {
                                        <span class="badge bg-nord-surface border border-nord text-nord-ice" style="font-size: 0.65rem;">
                                            @currentCard.MoscowPriority.Value.ToString()
                                        </span>
                                    }
                                    @if (currentCard.SprintNumber.HasValue)
                                    {
                                        <span class="badge border border-nord text-nord-snow bg-nord-dark small" style="font-size: 0.7rem;">
                                            @($"S{currentCard.SprintNumber.Value}")
                                        </span>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 ms-1" style="font-size: 0.7rem; height: 22px;" title="Use Case bewerken" @onclick="() => OpenEditCardModal(currentCard)" @onclick:stopPropagation="true">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(currentCard.Description))
                            {
                                <p class="small text-nord-dim mb-2 text-break" style="max-height: 60px; overflow: hidden;">
                                    @currentCard.Description
                                </p>
                            }

                            <!-- SUBTASKS PROGRESS BADGE -->
                            @if (totalSubTasks > 0)
                            {
                                <div class="d-flex align-items-center gap-1 mb-2 text-nord-dim small" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-list-check"></i>
                                    <span>Subtasks: @doneSubTasks / @totalSubTasks</span>
                                </div>
                            }

                            <!-- LABELS -->
                            @if (currentCard.Labels.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var label in currentCard.Labels)
                                    {
                                        <span class="badge text-white" style="background-color: @label.ColorHex; font-size: 0.68rem;">
                                            @label.Name
                                        </span>
                                    }
                                </div>
                            }

                            <!-- FOOTER -->
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-nord" @onclick:stopPropagation="true">
                                <small class="text-nord-dim" style="font-size: 0.7rem;">
                                    @(currentCard.DueDate.HasValue ? $"📅 {currentCard.DueDate.Value.ToLocalTime():dd MMM}" : "")
                                </small>

                                <select class="form-select form-select-sm py-0 px-2"
                                        style="font-size: 0.75rem; height: 26px; width: auto;"
                                        value="@currentCard.Status"
                                        @onchange="(e) => OnStatusDropdownChanged(currentCard, e)">
                                    @foreach (var targetCol in _columns)
                                    {
                                        <option value="@targetCol.Status">@targetCol.Title</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    <button type="button" class="btn btn-outline-secondary btn-sm border-dashed py-2 mt-auto" @onclick="() => OpenCreateCardModal(col.Status)">
                        <i class="fa-solid fa-plus me-1"></i> Use Case toevoegen
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL: FLOWBOARD DELEN & PUBLIEKE SWITCH -->
@if (_showShareModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); backdrop-filter: blur(2px); z-index: 1065;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-nord-snow">
                        <i class="fa-solid fa-share-nodes me-2 text-nord-ice"></i>FlowBoard Delen & Toegang
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => _showShareModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_shareModalErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-3 border-0 text-nord-snow rounded-2" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> @_shareModalErrorMessage
                        </div>
                    }

                    <!-- OPENBARE LINK SWITCH -->
                    <div class="mb-4 p-3 bg-nord-dark rounded border border-nord">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <label class="form-label text-nord-snow small fw-semibold mb-0">Openbare Toegang (Geen Login Nodig)</label>
                                <p class="text-nord-dim small mb-0">Maak het bord openbaar zodat iedereen met de link het kan inzien (Read-Only).</p>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" checked="@_isPublic" @onchange="TogglePublicAccess" />
                            </div>
                        </div>

                        @if (_isPublic)
                        {
                            <div class="input-group mt-3">
                                <input type="text" class="form-control form-control-sm text-muted" readonly value="@GetShareableLink()" />
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyShareableLink">
                                    <i class="fa-solid fa-copy me-1"></i> @(_linkCopied ? "Gekopieerd!" : "Kopiëren")
                                </button>
                            </div>
                        }
                    </div>

                    <!-- DIRECT DELEN VIA E-MAIL -->
                    <div class="mb-4">
                        <label class="form-label text-nord-snow small fw-semibold">Nieuw account machtigen via e-mail</label>
                        <div class="input-group">
                            <input type="email" class="form-control" placeholder="collega@domein.nl" @bind="_shareUserEmail" />
                            <button type="button" class="btn btn-primary" @onclick="ExecuteShareBoard" disabled="@_isSharing">
                                @if (_isSharing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-user-plus me-1"></i>
                                }
                                <span>Delen</span>
                            </button>
                        </div>
                    </div>

                    <!-- ACTIEVE DEELNEMERS -->
                    <div>
                        <h6 class="text-uppercase text-nord-dim fw-bold small mb-2">Actieve Deelnemers (@_sharedMembers.Count)</h6>
                        @if (_isLoadingMembers)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-nord-ice" role="status"></div>
                                <span class="ms-2 small text-nord-dim">Leden ophalen...</span>
                            </div>
                        }
                        else if (!_sharedMembers.Any())
                        {
                            <div class="p-3 bg-nord-dark rounded border border-nord text-center">
                                <p class="text-nord-dim small mb-0 fst-italic">Dit bord is nog niet gedeeld met specifieke accounts.</p>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush rounded border border-nord" style="max-height: 150px; overflow-y: auto;">
                                @foreach (var member in _sharedMembers)
                                {
                                    <div class="list-group-item bg-nord-dark border-nord d-flex justify-content-between align-items-center py-2 px-3">
                                        <div class="d-flex align-items-center gap-2 text-truncate pe-2">
                                            <i class="fa-solid fa-user text-nord-ice small"></i>
                                            <span class="text-nord-snow small text-truncate">@member.Email</span>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2 flex-shrink-0"
                                                title="Toegang direct intrekken"
                                                @onclick="() => RevokeShare(member.Id)"
                                                disabled="@_isRevoking">
                                            <i class="fa-solid fa-user-minus me-1"></i> Intrekken
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-nord">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showShareModal = false">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- USE CASE BEWERK / MAAK MODAL -->
@if (_showCardModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(_isEditingCard ? "Use Case Bewerken" : "Nieuwe Use Case Aanmaken")</h5>
                    <button type="button" class="btn-close" @onclick="() => _showCardModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Titel (Use Case Naam)</label>
                        <input type="text" class="form-control" placeholder="bijv. Gebruiker kan inloggen" @bind="_cardTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beschrijving</label>
                        <textarea class="form-control" rows="2" placeholder="Acceptatiecriteria..." @bind="_cardDescription"></textarea>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Status / Kolom</label>
                            <select class="form-select" @bind="_cardStatus">
                                @foreach (var col in _columns)
                                {
                                    <option value="@col.Status">@col.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sprint</label>
                            <select class="form-select" @bind="_cardSprint">
                                <option value="">Geen Sprint</option>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    var sNum = i;
                                    <option value="@sNum">Sprint @sNum</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">MoSCoW Prioriteit</label>
                            <select class="form-select" @bind="_cardMoscowPriority">
                                <option value="">Geen Prioriteit</option>
                                <option value="@MoscowPriority.MustHave">Must Have</option>
                                <option value="@MoscowPriority.ShouldHave">Should Have</option>
                                <option value="@MoscowPriority.CouldHave">Could Have</option>
                                <option value="@MoscowPriority.WontHave">Won't Have</option>
                            </select>
                        </div>
                    </div>

                    <!-- SUBTASKS KANBAN SECTIE -->
                    <div class="mb-3 p-3 bg-nord-dark rounded border border-nord">
                        <label class="form-label fw-bold text-nord-snow mb-2">
                            <i class="fa-solid fa-list-check me-1 text-nord-ice"></i> Subtasks Workflow (Todo, Testing, Done)
                        </label>

                        <div class="input-group mb-3">
                            <input type="text" class="form-control form-control-sm" placeholder="Subtask titel..." @bind="_newSubTaskTitle" />
                            <select class="form-select form-select-sm w-auto" @bind="_newSubTaskStatus">
                                <option value="@SubTaskStatus.Todo">Todo</option>
                                <option value="@SubTaskStatus.Testing">Testing</option>
                                <option value="@SubTaskStatus.Done">Done</option>
                            </select>
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddSubTask">
                                <i class="fa-solid fa-plus me-1"></i> Toevoegen
                            </button>
                        </div>

                        <!-- 3 SUBTASK KOLOMMEN -->
                        <div class="row g-2">
                            <!-- TODO KOLOM -->
                            <div class="col-md-4">
                                <div class="p-2 bg-nord-card rounded border border-nord h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-nord">
                                        <span class="small fw-bold text-uppercase" style="color: #4c566a;">Todo</span>
                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.65rem;">@_currentSubTasks.Count(st => st.Status == SubTaskStatus.Todo)</span>
                                    </div>
                                    <div class="d-flex flex-column gap-2" style="min-height: 80px; max-height: 180px; overflow-y: auto;">
                                        @foreach (var subTaskItem in _currentSubTasks.Where(st => st.Status == SubTaskStatus.Todo))
                                        {
                                            var currentSubTask = subTaskItem;
                                            <div class="p-2 bg-nord-dark rounded border border-nord d-flex justify-content-between align-items-start">
                                                @if (_editingSubTaskId == currentSubTask.Id)
                                                {
                                                    <input type="text" class="form-control form-control-sm me-1 flex-grow-1" @bind="currentSubTask.Title" @onblur="() => SaveSubTaskEdit(currentSubTask)" autofocus />
                                                }
                                                else
                                                {
                                                    <span class="text-nord-snow small text-break pe-2 flex-grow-1" title="@currentSubTask.Title">@currentSubTask.Title</span>
                                                }
                                                <div class="d-flex gap-1 flex-shrink-0 align-self-start">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.65rem;" title="Bewerken" @onclick="() => ToggleSubTaskEdit(currentSubTask.Id)">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.65rem;" title="Verplaats naar Testing" @onclick="() => MoveSubTaskStatus(currentSubTask, SubTaskStatus.Testing)">
                                                        <i class="fa-solid fa-arrow-right"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 0.65rem;" title="Verwijderen" @onclick="() => DeleteSubTask(currentSubTask.Id)">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- TESTING KOLOM -->
                            <div class="col-md-4">
                                <div class="p-2 bg-nord-card rounded border border-nord h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-nord">
                                        <span class="small fw-bold text-uppercase" style="color: #b48ead;">Testing</span>
                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.65rem;">@_currentSubTasks.Count(st => st.Status == SubTaskStatus.Testing)</span>
                                    </div>
                                    <div class="d-flex flex-column gap-2" style="min-height: 80px; max-height: 180px; overflow-y: auto;">
                                        @foreach (var subTaskItem in _currentSubTasks.Where(st => st.Status == SubTaskStatus.Testing))
                                        {
                                            var currentSubTask = subTaskItem;
                                            <div class="p-2 bg-nord-dark rounded border border-nord d-flex justify-content-between align-items-start">
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 flex-shrink-0 align-self-start me-1" style="font-size: 0.65rem;" title="Terug naar Todo" @onclick="() => MoveSubTaskStatus(currentSubTask, SubTaskStatus.Todo)">
                                                    <i class="fa-solid fa-arrow-left"></i>
                                                </button>
                                                @if (_editingSubTaskId == currentSubTask.Id)
                                                {
                                                    <input type="text" class="form-control form-control-sm mx-1 flex-grow-1" @bind="currentSubTask.Title" @onblur="() => SaveSubTaskEdit(currentSubTask)" autofocus />
                                                }
                                                else
                                                {
                                                    <span class="text-nord-snow small text-break px-1 flex-grow-1" title="@currentSubTask.Title">@currentSubTask.Title</span>
                                                }
                                                <div class="d-flex gap-1 flex-shrink-0 align-self-start">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.65rem;" title="Bewerken" @onclick="() => ToggleSubTaskEdit(currentSubTask.Id)">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.65rem;" title="Verplaats naar Done" @onclick="() => MoveSubTaskStatus(currentSubTask, SubTaskStatus.Done)">
                                                        <i class="fa-solid fa-arrow-right"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 0.65rem;" title="Verwijderen" @onclick="() => DeleteSubTask(currentSubTask.Id)">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- DONE KOLOM -->
                            <div class="col-md-4">
                                <div class="p-2 bg-nord-card rounded border border-nord h-100">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-nord">
                                        <span class="small fw-bold text-uppercase" style="color: #a3be8c;">Done</span>
                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.65rem;">@_currentSubTasks.Count(st => st.Status == SubTaskStatus.Done)</span>
                                    </div>
                                    <div class="d-flex flex-column gap-2" style="min-height: 80px; max-height: 180px; overflow-y: auto;">
                                        @foreach (var subTaskItem in _currentSubTasks.Where(st => st.Status == SubTaskStatus.Done))
                                        {
                                            var currentSubTask = subTaskItem;
                                            <div class="p-2 bg-nord-dark rounded border border-nord d-flex justify-content-between align-items-start">
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 flex-shrink-0 align-self-start me-1" style="font-size: 0.65rem;" title="Terug naar Testing" @onclick="() => MoveSubTaskStatus(currentSubTask, SubTaskStatus.Testing)">
                                                    <i class="fa-solid fa-arrow-left"></i>
                                                </button>
                                                @if (_editingSubTaskId == currentSubTask.Id)
                                                {
                                                    <input type="text" class="form-control form-control-sm mx-1 flex-grow-1" @bind="currentSubTask.Title" @onblur="() => SaveSubTaskEdit(currentSubTask)" autofocus />
                                                }
                                                else
                                                {
                                                    <span class="text-decoration-line-through text-nord-dim small text-break px-1 flex-grow-1" title="@currentSubTask.Title">@currentSubTask.Title</span>
                                                }
                                                <div class="d-flex gap-1 flex-shrink-0 align-self-start">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.65rem;" title="Bewerken" @onclick="() => ToggleSubTaskEdit(currentSubTask.Id)">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 flex-shrink-0" style="font-size: 0.65rem;" title="Verwijderen" @onclick="() => DeleteSubTask(currentSubTask.Id)">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LABELS SECTIE -->
                    <div class="mb-3">
                        <label class="form-label">Labels</label>
                        <div class="d-flex flex-wrap gap-2 pt-1">
                            @foreach (var label in _availableLabels)
                            {
                                var isSelected = _selectedLabelIds.Contains(label.Id);
                                <button type="button"
                                        class="btn btn-sm @(isSelected ? "text-white shadow-sm" : "btn-outline-secondary")"
                                        style="background-color: @(isSelected ? label.ColorHex : "transparent"); border-color: @label.ColorHex;"
                                        @onclick="() => ToggleLabelSelection(label.Id)">
                                    @label.Name
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    @if (_isEditingCard && _editingCardId.HasValue)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeleteCard(_editingCardId.Value)">
                            <i class="fa-solid fa-trash me-1"></i> Verwijderen
                        </button>
                    }
                    else
                    {
                        <div></div>
                    }
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showCardModal = false">Annuleren</button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCard">Opslaan</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- LABELS BEHEREN MODAL -->
@if (_showLabelModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Labels Beheren</h5>
                    <button type="button" class="btn-close" @onclick="() => _showLabelModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 p-3 bg-nord-dark rounded border border-nord">
                        <h6 class="fw-bold mb-2 text-nord-snow">Nieuw Label</h6>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control" placeholder="Labelnaam" @bind="_newLabelName" />
                            <input type="color" class="form-control form-control-color bg-nord-dark" style="width: 50px;" @bind="_newLabelColor" />
                            <button type="button" class="btn btn-primary text-nowrap" @onclick="CreateLabel">Toevoegen</button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var lbl in _availableLabels)
                        {
                            <span class="badge text-white p-2" style="background-color: @lbl.ColorHex;">@lbl.Name</span>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showLabelModal = false">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? BoardId { get; set; }
    [Parameter] public Guid? ProjectId { get; set; }

    private Guid _activeBoardId;
    private List<KanbanCardDto> _allCards = new();
    private List<KanbanCardDto> _filteredCards = new();
    private List<BoardLabelDto> _availableLabels = new();

    private KanbanCardDto? _draggedCard;
    private string? _errorMessage;
    private int _selectedSprintFilter = -1;

    // Share Modal States
    private bool _showShareModal;
    private bool _isPublic;
    private string _shareUserEmail = string.Empty;
    private string? _shareModalErrorMessage;
    private bool _isSharing;
    private bool _isLoadingMembers;
    private bool _isRevoking;
    private bool _linkCopied;
    private List<BoardMemberViewDto> _sharedMembers = new();

    // Modal States
    private bool _showCardModal;
    private bool _isEditingCard;
    private Guid? _editingCardId;
    private string _cardTitle = string.Empty;
    private string _cardDescription = string.Empty;
    private KanbanColumnStatus _cardStatus = KanbanColumnStatus.Backlog;
    private string _cardSprint = string.Empty;
    private MoscowPriority? _cardMoscowPriority;
    private List<Guid> _selectedLabelIds = new();
    private List<SubTaskDto> _currentSubTasks = new();
    private string _newSubTaskTitle = string.Empty;
    private SubTaskStatus _newSubTaskStatus = SubTaskStatus.Todo;
    private Guid? _editingSubTaskId;

    private bool _showLabelModal;
    private string _newLabelName = string.Empty;
    private string _newLabelColor = "#88c0d0";

    private record ColumnDef(KanbanColumnStatus Status, string Title, string HeaderColor);
    private readonly List<ColumnDef> _columns =
    [
        new(KanbanColumnStatus.Backlog, "Backlog", "#4c566a"),
        new(KanbanColumnStatus.CurrentSprint, "Current Sprint", "#88c0d0"),
        new(KanbanColumnStatus.Ongoing, "Ongoing", "#ebcb8b"),
        new(KanbanColumnStatus.Testing, "Testing", "#b48ead"),
        new(KanbanColumnStatus.Done, "Done", "#a3be8c"),
        new(KanbanColumnStatus.OnHold, "On Hold", "#bf616a")
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (BoardId.HasValue && BoardId.Value != Guid.Empty)
        {
            _activeBoardId = BoardId.Value;
            await LoadBoardData();
        }
        else if (ProjectId.HasValue && ProjectId.Value != Guid.Empty)
        {
            await LoadOrCreateProjectBoard(ProjectId.Value);
        }
    }

    private async Task LoadOrCreateProjectBoard(Guid projId)
    {
        try
        {
            var boards = await Http.GetFromJsonAsync<List<KanbanBoardDto>>($"api/boards?projectId={projId}") ?? [];
            var board = boards.FirstOrDefault();
            if (board == null)
            {
                var createResponse = await Http.PostAsJsonAsync("api/boards", new CreateKanbanBoardDto
                {
                    Title = "Project FlowBoard",
                    Description = "Automatisch aangemaakt bord",
                    ProjectId = projId
                });
                if (createResponse.IsSuccessStatusCode)
                {
                    board = await createResponse.Content.ReadFromJsonAsync<KanbanBoardDto>();
                }
            }
            if (board != null)
            {
                _activeBoardId = board.Id;
                await LoadBoardData();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij laden bord: {ex.Message}";
        }
    }

    private async Task LoadBoardData()
    {
        try
        {
            _allCards = await Http.GetFromJsonAsync<List<KanbanCardDto>>($"api/flowboard?boardId={_activeBoardId}") ?? [];
            _availableLabels = await Http.GetFromJsonAsync<List<BoardLabelDto>>($"api/boardlabels?boardId={_activeBoardId}") ?? [];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij laden kaarten: {ex.Message}";
        }
    }

    private string GetShareableLink()
    {
        return $"{Navigation.BaseUri}shared-board/{_activeBoardId}";
    }

    private async Task CopyShareableLink()
    {
        _linkCopied = true;
        StateHasChanged();
        await Task.Delay(2500);
        _linkCopied = false;
        StateHasChanged();
    }

    private async Task OpenShareModal()
    {
        _showShareModal = true;
        _shareUserEmail = string.Empty;
        _shareModalErrorMessage = null;
        _linkCopied = false;

        try
        {
            var boardDto = await Http.GetFromJsonAsync<KanbanBoardDto>($"api/boards/{_activeBoardId}");
            if (boardDto != null)
            {
                _isPublic = boardDto.IsPublic;
            }
        }
        catch
        {
            // Ignored if fetch fails
        }

        await LoadMembers();
    }

    private async Task TogglePublicAccess(ChangeEventArgs e)
    {
        var newState = (bool)(e.Value ?? false);
        _isPublic = newState;

        try
        {
            await Http.PatchAsJsonAsync($"api/boards/{_activeBoardId}/public", new { IsPublic = newState });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij bijwerken openbare status: {ex.Message}";
        }
    }

    private async Task LoadMembers()
    {
        _isLoadingMembers = true;
        try
        {
            _sharedMembers = await Http.GetFromJsonAsync<List<BoardMemberViewDto>>($"api/boards/{_activeBoardId}/members") ?? [];
        }
        catch
        {
            _sharedMembers = [];
        }
        finally
        {
            _isLoadingMembers = false;
        }
    }

    private async Task ExecuteShareBoard()
    {
        if (string.IsNullOrWhiteSpace(_shareUserEmail))
        {
            _shareModalErrorMessage = "Vul een e-mailadres in.";
            return;
        }

        _isSharing = true;
        _shareModalErrorMessage = null;
        try
        {
            var payload = new { Email = _shareUserEmail.Trim() };
            var response = await Http.PostAsJsonAsync($"api/boards/{_activeBoardId}/share", payload);
            if (response.IsSuccessStatusCode)
            {
                _shareUserEmail = string.Empty;
                await LoadMembers();
            }
            else
            {
                _shareModalErrorMessage = "Kan bord niet delen met dit e-mailadres.";
            }
        }
        catch (Exception ex)
        {
            _shareModalErrorMessage = $"Verbindingsfout: {ex.Message}";
        }
        finally
        {
            _isSharing = false;
        }
    }

    private async Task RevokeShare(string userId)
    {
        _isRevoking = true;
        _shareModalErrorMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"api/boards/{_activeBoardId}/share/{userId}");
            if (response.IsSuccessStatusCode)
            {
                _sharedMembers.RemoveAll(m => m.Id == userId);
            }
        }
        catch (Exception ex)
        {
            _shareModalErrorMessage = $"Verbindingsfout: {ex.Message}";
        }
        finally
        {
            _isRevoking = false;
        }
    }

    private void ApplyFilter()
    {
        if (_selectedSprintFilter == -1) _filteredCards = _allCards;
        else if (_selectedSprintFilter == 0) _filteredCards = _allCards.Where(c => !c.SprintNumber.HasValue).ToList();
        else _filteredCards = _allCards.Where(c => c.SprintNumber == _selectedSprintFilter).ToList();
    }

    private void OpenCreateCardModal(KanbanColumnStatus defaultStatus = KanbanColumnStatus.Backlog)
    {
        _isEditingCard = false;
        _editingCardId = null;
        _cardTitle = string.Empty;
        _cardDescription = string.Empty;
        _cardStatus = defaultStatus;
        _cardSprint = _selectedSprintFilter > 0 ? _selectedSprintFilter.ToString() : string.Empty;
        _cardMoscowPriority = null;
        _selectedLabelIds.Clear();
        _currentSubTasks.Clear();
        _editingSubTaskId = null;
        _showCardModal = true;
    }

    private void OpenEditCardModal(KanbanCardDto card)
    {
        _isEditingCard = true;
        _editingCardId = card.Id;
        _cardTitle = card.Title;
        _cardDescription = card.Description ?? string.Empty;
        _cardStatus = card.Status;
        _cardSprint = card.SprintNumber.HasValue ? card.SprintNumber.Value.ToString() : string.Empty;
        _cardMoscowPriority = card.MoscowPriority;
        _selectedLabelIds = card.Labels.Select(l => l.Id).ToList();
        _currentSubTasks = new List<SubTaskDto>(card.SubTasks);
        _editingSubTaskId = null;
        _showCardModal = true;
    }

    private void ToggleLabelSelection(Guid labelId)
    {
        if (_selectedLabelIds.Contains(labelId)) _selectedLabelIds.Remove(labelId);
        else _selectedLabelIds.Add(labelId);
    }

    private async Task AddSubTask()
    {
        if (string.IsNullOrWhiteSpace(_newSubTaskTitle)) return;

        if (_isEditingCard && _editingCardId.HasValue)
        {
            var dto = new CreateSubTaskDto { Title = _newSubTaskTitle, Status = _newSubTaskStatus };
            var response = await Http.PostAsJsonAsync($"api/flowboard/cards/{_editingCardId.Value}/subtasks", dto);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<SubTaskDto>();
                if (created != null) _currentSubTasks.Add(created);
                _newSubTaskTitle = string.Empty;
            }
        }
        else
        {
            _currentSubTasks.Add(new SubTaskDto
            {
                Id = Guid.NewGuid(),
                Title = _newSubTaskTitle.Trim(),
                Status = _newSubTaskStatus
            });
            _newSubTaskTitle = string.Empty;
        }
    }

    private void ToggleSubTaskEdit(Guid subTaskId)
    {
        _editingSubTaskId = _editingSubTaskId == subTaskId ? null : subTaskId;
    }

    private async Task SaveSubTaskEdit(SubTaskDto st)
    {
        _editingSubTaskId = null;
        if (_isEditingCard && _editingCardId.HasValue)
        {
            await Http.PatchAsJsonAsync($"api/flowboard/subtasks/{st.Id}/status", new UpdateSubTaskDto { Title = st.Title, Status = st.Status });
        }
    }

    private async Task MoveSubTaskStatus(SubTaskDto st, SubTaskStatus newStatus)
    {
        st.Status = newStatus;
        if (_isEditingCard && _editingCardId.HasValue)
        {
            await Http.PatchAsJsonAsync($"api/flowboard/subtasks/{st.Id}/status", new UpdateSubTaskDto { Title = st.Title, Status = st.Status });
        }
    }

    private async Task DeleteSubTask(Guid subTaskId)
    {
        if (_isEditingCard && _editingCardId.HasValue)
        {
            var response = await Http.DeleteAsync($"api/flowboard/subtasks/{subTaskId}");
            if (response.IsSuccessStatusCode) _currentSubTasks.RemoveAll(st => st.Id == subTaskId);
        }
        else
        {
            _currentSubTasks.RemoveAll(st => st.Id == subTaskId);
        }
    }

    private async Task SaveCard()
    {
        if (string.IsNullOrWhiteSpace(_cardTitle))
        {
            _errorMessage = "Voer minimaal een titel in voor de use case.";
            return;
        }

        int? sprintNr = int.TryParse(_cardSprint, out var parsedSprint) ? parsedSprint : null;

        if (_isEditingCard && _editingCardId.HasValue)
        {
            var updateDto = new UpdateKanbanCardDto
            {
                Title = _cardTitle,
                Description = _cardDescription,
                Status = _cardStatus,
                SprintNumber = sprintNr,
                MoscowPriority = _cardMoscowPriority,
                LabelIds = _selectedLabelIds
            };
            var response = await Http.PutAsJsonAsync($"api/flowboard/{_editingCardId.Value}", updateDto);
            if (response.IsSuccessStatusCode)
            {
                _showCardModal = false;
                await LoadBoardData();
            }
        }
        else
        {
            var createDto = new CreateKanbanCardDto
            {
                Title = _cardTitle,
                Description = _cardDescription,
                Status = _cardStatus,
                SprintNumber = sprintNr,
                MoscowPriority = _cardMoscowPriority,
                BoardId = _activeBoardId,
                LabelIds = _selectedLabelIds,
                SubTasks = _currentSubTasks.Select(st => new CreateSubTaskDto { Title = st.Title, Status = st.Status }).ToList()
            };
            var response = await Http.PostAsJsonAsync("api/flowboard", createDto);
            if (response.IsSuccessStatusCode)
            {
                _showCardModal = false;
                await LoadBoardData();
            }
        }
    }

    private async Task OnStatusDropdownChanged(KanbanCardDto card, ChangeEventArgs e)
    {
        if (Enum.TryParse<KanbanColumnStatus>(e.Value?.ToString(), out var newStatus))
        {
            await MoveCardStatus(card, newStatus);
        }
    }

    private async Task MoveCardStatus(KanbanCardDto card, KanbanColumnStatus newStatus)
    {
        card.Status = newStatus;
        await Http.PatchAsJsonAsync($"api/flowboard/{card.Id}/status", new UpdateKanbanCardStatusDto { Status = newStatus });
        ApplyFilter();
    }

    private async Task HandleDrop(KanbanColumnStatus targetStatus)
    {
        if (_draggedCard != null && _draggedCard.Status != targetStatus)
        {
            await MoveCardStatus(_draggedCard, targetStatus);
            _draggedCard = null;
        }
    }

    private async Task DeleteCard(Guid cardId)
    {
        var response = await Http.DeleteAsync($"api/flowboard/{cardId}");
        if (response.IsSuccessStatusCode)
        {
            _showCardModal = false;
            await LoadBoardData();
        }
    }

    private async Task CreateLabel()
    {
        if (string.IsNullOrWhiteSpace(_newLabelName)) return;
        var dto = new CreateBoardLabelDto { Name = _newLabelName, ColorHex = _newLabelColor, BoardId = _activeBoardId };
        var response = await Http.PostAsJsonAsync("api/boardlabels", dto);
        if (response.IsSuccessStatusCode)
        {
            _newLabelName = string.Empty;
            await LoadBoardData();
        }
    }

    public class BoardMemberViewDto
    {
        public string Id { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
    }
}