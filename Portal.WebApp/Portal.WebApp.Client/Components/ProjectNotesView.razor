@using System.Net.Http.Json
@using Portal.DTOs.Notes
@using Portal.DTOs.Projects
@inject HttpClient Http

@if (IsOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-nord shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-book-open me-2 text-nord-ice"></i>Notities: @(Project?.Title ?? "Project")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- NIEUWE NOTITIE FORMULIER MET RICH EDITOR -->
                    <div class="p-3 bg-nord-dark rounded border border-nord mb-4">
                        <h6 class="fw-bold text-nord-snow mb-3">Nieuwe Aantekening Toevoegen</h6>
                        <div class="mb-2">
                            <input type="text" class="form-control" placeholder="Titel van de notitie..." @bind="_newNoteTitle" />
                        </div>
                        <div class="mb-3">
                            <RichNoteEditor @bind-Value="_newNoteContent" />
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="CreateNote">
                                <i class="fa-solid fa-plus me-1"></i> Notitie Opslaan
                            </button>
                        </div>
                    </div>

                    <!-- BESTAANDE NOTITIES LIJST MET MARKDOWN RENDERING -->
                    <h6 class="fw-bold text-nord-dim text-uppercase small mb-2">Bestaande Aantekeningen (@Notes.Count)</h6>
                    @if (!Notes.Any())
                    {
                        <p class="text-nord-dim small fst-italic">Nog geen documentatie aanwezig voor dit project.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 overflow-y-auto" style="max-height: 350px;">
                            @foreach (var note in Notes.OrderByDescending(n => n.CreatedAt))
                            {
                                <div class="p-3 bg-nord-dark rounded border border-nord">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-nord">
                                        <strong class="text-nord-ice">@note.Title</strong>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-nord-dim small" style="font-size: 0.75rem;">
                                                @note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" title="Verwijderen" @onclick="() => DeleteNote(note.Id)">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <MarkdownView Content="@note.Content" />
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ProjectDto? Project { get; set; }
    [Parameter] public List<NoteDto> Notes { get; set; } = new();
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnNotesUpdated { get; set; }

    private string _newNoteTitle = string.Empty;
    private string _newNoteContent = string.Empty;

    private async Task Close() => await OnClosed.InvokeAsync();

    private async Task CreateNote()
    {
        if (Project == null || string.IsNullOrWhiteSpace(_newNoteTitle)) return;

        var dto = new CreateNoteDto
        {
            Title = _newNoteTitle,
            Content = _newNoteContent,
            ProjectId = Project.Id
        };

        var response = await Http.PostAsJsonAsync("api/notes", dto);
        if (response.IsSuccessStatusCode)
        {
            _newNoteTitle = string.Empty;
            _newNoteContent = string.Empty;
            await OnNotesUpdated.InvokeAsync();
        }
    }

    private async Task DeleteNote(Guid noteId)
    {
        var response = await Http.DeleteAsync($"api/notes/{noteId}");
        if (response.IsSuccessStatusCode)
        {
            await OnNotesUpdated.InvokeAsync();
        }
    }
}