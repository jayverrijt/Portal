@using System.Net.Http.Json
@using Portal.DTOs.Notes
@using Portal.DTOs.Projects
@inject HttpClient Http

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(2px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" style="max-height: 90vh;">
            <div class="modal-content border-nord shadow-lg" style="max-height: 90vh; display: flex; flex-direction: column;">
                <div class="modal-header flex-shrink-0">
                    <h5 class="modal-title fw-bold text-nord-snow">
                        <i class="fa-solid fa-book-open me-2 text-nord-ice"></i>Notities: @(Project?.Title ?? "Project")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body overflow-y-auto p-4" style="flex: 1 1 auto; min-height: 0;">
                    <!-- NIEUWE NOTITIE FORMULIER MET RICH EDITOR -->
                    <div class="p-3 bg-nord-dark rounded border border-nord mb-4 shadow-sm">
                        <h6 class="fw-bold text-nord-snow mb-3">Nieuwe Aantekening Toevoegen</h6>
                        <div class="mb-2">
                            <input type="text" class="form-control" placeholder="Titel van de notitie..." @bind="_newNoteTitle" />
                        </div>
                        <div class="mb-3">
                            <RichNoteEditor @bind-Value="_newNoteContent" />
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="CreateNote" disabled="@_isSubmitting">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Opslaan...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-plus me-1"></i>
                                    <span>Notitie Opslaan</span>
                                }
                            </button>
                        </div>
                    </div>

                    <!-- BESTAANDE NOTITIES LIJST MET MARKDOWN RENDERING -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-nord-dim text-uppercase small m-0">Bestaande Aantekeningen (@Notes.Count)</h6>
                    </div>

                    @if (!Notes.Any())
                    {
                        <div class="p-4 text-center border border-nord rounded bg-nord-dark">
                            <p class="text-nord-dim small fst-italic mb-0">Nog geen documentatie aanwezig voor dit project.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var note in Notes.OrderByDescending(n => n.CreatedAt))
                            {
                                <div class="bg-nord-dark rounded border border-nord shadow-sm d-flex flex-column" style="max-height: 280px;">
                                    <div class="d-flex justify-content-between align-items-center py-2 px-3 border-bottom border-nord flex-shrink-0 bg-nord-card rounded-top">
                                        <strong class="text-nord-ice text-truncate pe-2" title="@note.Title">@note.Title</strong>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span class="text-nord-dim small" style="font-size: 0.75rem;">
                                                @note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" title="Verwijderen" @onclick="() => DeleteNote(note.Id)">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="p-3 overflow-y-auto text-nord-snow" style="min-height: 0; font-size: 0.88rem; line-height: 1.5;">
                                        <MarkdownView Content="@note.Content" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer flex-shrink-0 border-nord">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ProjectDto? Project { get; set; }
    [Parameter] public List<NoteDto> Notes { get; set; } = new();
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnNotesUpdated { get; set; }

    private string _newNoteTitle = string.Empty;
    private string _newNoteContent = string.Empty;
    private bool _isSubmitting;

    private async Task Close() => await OnClosed.InvokeAsync();

    private async Task CreateNote()
    {
        if (Project == null || string.IsNullOrWhiteSpace(_newNoteTitle)) return;

        _isSubmitting = true;
        try
        {
            var dto = new CreateNoteDto
            {
                Title = _newNoteTitle.Trim(),
                Content = _newNoteContent,
                ProjectId = Project.Id
            };

            var response = await Http.PostAsJsonAsync("api/notes", dto);
            if (response.IsSuccessStatusCode)
            {
                _newNoteTitle = string.Empty;
                _newNoteContent = string.Empty;
                await OnNotesUpdated.InvokeAsync();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task DeleteNote(Guid noteId)
    {
        var response = await Http.DeleteAsync($"api/notes/{noteId}");
        if (response.IsSuccessStatusCode)
        {
            await OnNotesUpdated.InvokeAsync();
        }
    }
}