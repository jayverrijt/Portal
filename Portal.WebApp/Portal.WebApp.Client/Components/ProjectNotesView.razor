@using System.Net.Http.Json
@using Portal.DTOs.Notes
@using Portal.DTOs.Projects
@inject HttpClient Http

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75); backdrop-filter: blur(4px); z-index: 1055;">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" style="max-height: 88vh; margin: 1.5rem auto;">
            <div class="modal-content border-nord shadow-lg bg-nord-dark" style="max-height: 88vh;">

                <!-- HEADER (ALTIJD VAST BOVENIN) -->
                <div class="modal-header border-nord py-3 px-4 flex-shrink-0" style="background-color: #2e3440;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-book-open text-nord-ice fs-5"></i>
                        <h5 class="modal-title fw-bold text-nord-snow m-0">Notities: @(Project?.Title ?? "Project")</h5>
                        <span class="badge bg-nord-surface text-nord-dim border border-nord ms-2">@Notes.Count</span>
                    </div>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <!-- SCROLLBARE INHOUD -->
                <div class="modal-body p-4 text-nord-snow" style="overflow-y: auto; max-height: calc(88vh - 135px);">

                    <!-- ACTIEBALK / INKLAPBAAR FORMULIER -->
                    <div class="mb-4">
                        @if (!_showCreateForm)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 py-2 border-dashed" @onclick="() => _showCreateForm = true">
                                <i class="fa-solid fa-plus me-1 text-nord-ice"></i> Nieuwe aantekening toevoegen...
                            </button>
                        }
                        else
                        {
                            <div class="p-3 bg-nord-surface rounded border border-nord shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold text-nord-snow m-0 small text-uppercase">Nieuwe Aantekening</h6>
                                    <button type="button" class="btn btn-sm text-nord-dim p-0" @onclick="() => _showCreateForm = false">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                                <div class="mb-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="Titel van de notitie..." @bind="_newNoteTitle" />
                                </div>
                                <div class="mb-3">
                                    <RichNoteEditor @bind-Value="_newNoteContent" />
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showCreateForm = false">Annuleren</button>
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="CreateNote" disabled="@_isSubmitting">
                                        @if (_isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>Opslaan...</span>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-plus me-1"></i>
                                            <span>Notitie Opslaan</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- BESTAANDE NOTITIES LIJST -->
                    <h6 class="fw-bold text-nord-dim text-uppercase small mb-3">Aantekeningen overzicht</h6>

                    @if (!Notes.Any())
                    {
                        <div class="p-4 text-center border border-nord rounded bg-nord-surface">
                            <p class="text-nord-dim small fst-italic mb-0">Nog geen documentatie aanwezig voor dit project.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var note in Notes.OrderByDescending(n => n.CreatedAt))
                            {
                                <div class="card border-nord bg-nord-card shadow-sm">
                                    <div class="card-header bg-nord-dark border-nord d-flex justify-content-between align-items-center py-2 px-3">
                                        <strong class="text-nord-ice text-truncate pe-2 small" title="@note.Title">@note.Title</strong>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span class="text-nord-dim" style="font-size: 0.72rem;">
                                                @note.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" title="Verwijderen" @onclick="() => DeleteNote(note.Id)">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body p-3 text-nord-snow small" style="line-height: 1.6; max-height: 260px; overflow-y: auto;">
                                        <MarkdownView Content="@note.Content" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- FOOTER (ALTIJD VAST ONDERIN) -->
                <div class="modal-footer border-nord py-2 px-4 flex-shrink-0" style="background-color: #2e3440;">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ProjectDto? Project { get; set; }
    [Parameter] public List<NoteDto> Notes { get; set; } = new();
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnNotesUpdated { get; set; }

    private string _newNoteTitle = string.Empty;
    private string _newNoteContent = string.Empty;
    private bool _showCreateForm = false;
    private bool _isSubmitting;

    private async Task Close()
    {
        _showCreateForm = false;
        await OnClosed.InvokeAsync();
    }

    private async Task CreateNote()
    {
        if (Project == null || string.IsNullOrWhiteSpace(_newNoteTitle)) return;

        _isSubmitting = true;
        try
        {
            var dto = new CreateNoteDto
            {
                Title = _newNoteTitle.Trim(),
                Content = _newNoteContent,
                ProjectId = Project.Id
            };

            var response = await Http.PostAsJsonAsync("api/notes", dto);
            if (response.IsSuccessStatusCode)
            {
                _newNoteTitle = string.Empty;
                _newNoteContent = string.Empty;
                _showCreateForm = false;
                await OnNotesUpdated.InvokeAsync();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task DeleteNote(Guid noteId)
    {
        var response = await Http.DeleteAsync($"api/notes/{noteId}");
        if (response.IsSuccessStatusCode)
        {
            await OnNotesUpdated.InvokeAsync();
        }
    }
}