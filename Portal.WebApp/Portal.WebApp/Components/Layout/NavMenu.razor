@using Microsoft.AspNetCore.Components.Authorization
@using Portal.WebApp.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Portal</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="projects">
                        <span class="bi bi-folder-fill-nav-menu" aria-hidden="true"></span> Projecten
                    </NavLink>
                </div>
                <div class="nav-item px-3 mt-3 border-top pt-3">
                    <span class="px-3 text-light small opacity-75">Ingelogd als:</span>
                    <div class="px-3 fw-bold text-white mb-2">@authContext.User.Identity?.Name</div>
                    <button class="btn btn-outline-light btn-sm ms-3" @onclick="HandleLogout">
                        Uitloggen
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-lock-fill-nav-menu" aria-hidden="true"></span> Inloggen
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        if (AuthStateProvider is CustomAuthStateProvider customStateProvider)
        {
            await customStateProvider.MarkUserAsLoggedOut();
        }
        Navigation.NavigateTo("/login");
    }
}